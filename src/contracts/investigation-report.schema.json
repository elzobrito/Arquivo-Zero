{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arquivo-zero.local/schemas/investigation-report.schema.json",
  "title": "InvestigationReport",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "caseId",
    "facts",
    "timeline",
    "route",
    "hypotheses",
    "validations",
    "conclusion",
    "limitations"
  ],
  "properties": {
    "caseId": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "event"
        ],
        "properties": {
          "timestamp": {
            "type": [
              "string",
              "null"
            ]
          },
          "event": {
            "type": "string"
          }
        }
      }
    },
    "route": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validations": {
      "type": "array"
    },
    "conclusion": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
